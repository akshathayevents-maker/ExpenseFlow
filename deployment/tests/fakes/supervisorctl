#!/bin/bash
# test double. State: $EF_TEST_STATE/workers ("<name> <pid>" per line). `no_respawn` file => restart does nothing.
S="${EF_TEST_STATE:?}"; W="$S/workers"
case "$1" in
  status) [[ -s "$W" ]] && while read -r n p; do echo "$n   RUNNING   pid $p, uptime 0:00:05"; done < "$W"; exit 0 ;;
  restart) n="$2"; echo "supervisorctl restart $n" >> "$S/calls.log"; [[ -f "$S/hang_restart" ]] && sleep 60
     if [[ ! -f "$S/no_respawn" ]]; then
        old="$(awk -v n="$n" '$1==n{print $2}' "$W")"; [[ -n "$old" ]] && kill "$old" 2>/dev/null
        ( exec sleep 600 >/dev/null 2>&1 </dev/null ) & np=$!; disown
        grep -v "^$n " "$W" > "$W.tmp"; echo "$n $np" >> "$W.tmp"; mv "$W.tmp" "$W"
     fi ;;
esac
